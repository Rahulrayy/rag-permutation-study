# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# IDE
.idea/
.vscode/

# Data & model caches (never commit these)
data/
cache/
*.sqlite
*.sqlite-journal
generations.jsonl
hf_cache/          # only if someone re-points cache_dir at the project

# Results: commit aggregate CSVs, not raw generations (see plan Sec. 6).
# Raw generations are reproducible from the cache and are large; aggregates
# under results/ are what belongs in the repo.
results/raw/
results/**/generations.csv
results/*_dummy/
analysis/figures/

# Lockfile IS committed (reproducibility); the venv is not.

# Secrets
.env
.pytest_cache/

# Working documents: kept local, not published. README.md is the only tracked
# markdown. Note these files remain in git history from earlier commits -- see
# `git log --diff-filter=D --name-only` -- so the pre-registration in
# ANALYSIS_PLAN.md is still timestamped and retrievable at its registration
# commit even though it is no longer present at HEAD.
*.md
!README.md
# The technical write-up is the detailed companion to README.md and is
# published with it; the other working documents stay local.
!WRITEUP.md
